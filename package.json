{
  "packageManager": "yarn@4.9.2",
  "type": "module",
  "name": "@masx200/mcp-streamable-http-bridge",
  "version": "2.0.0",
  "description": "A simple MCP calculator supporting addition, subtraction, multiplication and division",
  "scripts": {
    "build": "npx tsc  -p tsconfig.json",
    "start:bridge": "node bridge-streamable.js",
    "start:bridge-ts": "yarn run build:ts && node bridge-streamable-ts.js",
    "build:ts": "npx tsc  -p tsconfig.json",
    "dev:ts": "npx ts-node bridge-streamable-ts.ts"
  },
  "keywords": [
    "mcp",
    "calculator",
    "math"
  ],
  "author": "masx200",
  "license": "MIT",
  "dependencies": {
    "@dmitryrechkin/json-schema-to-zod": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.17.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/yargs": "^17.0.33",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "json-zod": "^0.1.0",
    "morgan": "^1.10.1",
    "typescript": "^5.9.2",
    "yargs": "^18.0.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/morgan": "^1",
    "ts-node": "^10.9.2"
  }
}
